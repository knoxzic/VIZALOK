# Supabase (browser-safe anon key only — never put service role in the client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server / webhook only (Edge Function secrets or Firebase config — never commit real values)
# SUPABASE_SERVICE_ROLE_KEY=never_commit_this
# STRIPE_SECRET_KEY=sk_live_or_test
# STRIPE_WEBHOOK_SECRET=whsec_...

